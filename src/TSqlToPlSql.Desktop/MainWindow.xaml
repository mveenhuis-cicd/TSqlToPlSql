<Window x:Class="TSqlToPlSql.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="T-SQL → PL/SQL Mapper" Height="800" Width="1300"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="Open_Executed" />
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="SaveAs_Executed" />
        <CommandBinding Command="ApplicationCommands.New" Executed="New_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="ApplicationCommands.Open" />
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.SaveAs" />
        <KeyBinding Key="N" Modifiers="Control" Command="ApplicationCommands.New" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Werkzeugleiste -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Neu" ToolTip="Neu (Strg+N)" Command="ApplicationCommands.New" />
                <Button Content="Öffnen …" ToolTip="T-SQL-Datei öffnen (Strg+O)" Command="ApplicationCommands.Open" />
                <Button Content="Ordner konvertieren …" ToolTip="Alle .sql-Dateien eines Ordners konvertieren" Click="ConvertFolder_Click" />
                <Separator />
                <Button Content="Konvertieren (F5)" FontWeight="SemiBold" Click="Convert_Click" />
                <CheckBox x:Name="AutoConvert" Content="Automatisch" IsChecked="True" VerticalAlignment="Center"
                          Margin="6,0" ToolTip="Beim Tippen automatisch konvertieren" />
                <Separator />
                <TextBlock Text="Ziel:" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox x:Name="TargetBox" Width="110" SelectedIndex="0" SelectionChanged="Option_Changed">
                    <ComboBoxItem Content="Oracle 19c" />
                    <ComboBoxItem Content="Oracle 23ai" />
                </ComboBox>
                <CheckBox x:Name="RemoveDbo" Content="dbo. entfernen" IsChecked="True" VerticalAlignment="Center"
                          Margin="8,0,4,0" Click="Option_Changed" />
                <CheckBox x:Name="Header" Content="Hinweis-Kopf" IsChecked="True" VerticalAlignment="Center"
                          Margin="4,0" Click="Option_Changed" />
                <Separator />
                <Button Content="Ergebnis kopieren" Click="Copy_Click" />
                <Button Content="Speichern unter …" ToolTip="PL/SQL speichern (Strg+S)" Command="ApplicationCommands.SaveAs" />
            </ToolBar>
        </ToolBarTray>

        <!-- Statusleiste -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Bereit" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="FileText" Foreground="#666" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="160" MinHeight="40" />
            </Grid.RowDefinitions>

            <!-- Editoren -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PaneHeader}"
                               Text="T-SQL (SQL Server) – einfügen, öffnen oder Datei hierher ziehen" />
                    <Border BorderBrush="#CCC" BorderThickness="1" Margin="6,0,0,6">
                        <TextBox x:Name="InputBox" Style="{StaticResource CodeBox}" TextChanged="InputBox_TextChanged" />
                    </Border>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#EEE" />

                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PaneHeader}" Text="PL/SQL (Oracle)" />
                    <Border BorderBrush="#CCC" BorderThickness="1" Margin="0,0,6,6">
                        <TextBox x:Name="OutputBox" Style="{StaticResource CodeBox}" IsReadOnly="True" Background="#FAFAFA" />
                    </Border>
                </DockPanel>
            </Grid>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#EEE" />

            <!-- Hinweise -->
            <DockPanel Grid.Row="2">
                <TextBlock x:Name="WarningsHeader" DockPanel.Dock="Top" Style="{StaticResource PaneHeader}" Text="Hinweise" />
                <ListBox x:Name="WarningsList" Margin="6,0,6,6" BorderBrush="#CCC" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
